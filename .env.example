# Copy to .env (or set in your host's dashboard). All values are optional.

# Public URL used for canonical links, Open Graph and structured data.
VITE_SITE_URL=https://media.zcorebit.com

# Base path the site is served from. Keep "/" for Vercel, Netlify or a custom
# domain. For a GitHub Pages project site use "/<repository-name>/".
VITE_BASE=/

# Optional form backend (e.g. https://formspree.io/f/xxxxxxx). When set, the
# contact form POSTs JSON here. When empty, the form opens a pre-filled email.
VITE_FORM_ENDPOINT=

# Optional soundtrack file inside /public (e.g. assets/audio/soundtrack.mp3).
# When empty or missing, the built-in generative ambient score plays instead.
VITE_SOUNDTRACK=assets/audio/soundtrack.mp3
